{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{core.color.slate.950}"
      },
      "surface": {
        "$value": "{core.color.alpha.white.4}"
      },
      "surface-raised": {
        "$value": "{core.color.alpha.white.8}"
      },
      "surface-solid": {
        "$value": "{core.color.navy.850}"
      },
      "field": {
        "$value": "{core.color.navy.800}"
      },
      "field-autofill": {
        "$value": "{core.color.navy.800}",
        "$description": "Fill behind text the browser autofilled. Opaque: the browser paints its own tint unless an opaque inset shadow covers it."
      }
    },
    "text": {
      "default": {
        "$value": "{core.color.mist.100}"
      },
      "muted": {
        "$value": "{core.color.slate.350}"
      },
      "subtle": {
        "$value": "{core.color.slate.450}"
      },
      "on-accent": {
        "$value": "{core.color.slate.950}"
      },
      "accent": {
        "$value": "{core.color.blue.300}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{core.color.alpha.white.12}"
      },
      "strong": {
        "$value": "{core.color.alpha.white.24}"
      }
    },
    "accent": {
      "default": {
        "$value": "{core.color.blue.400}"
      },
      "hover": {
        "$value": "{core.color.blue.300}"
      },
      "subtle": {
        "$value": "{core.color.alpha.blue-400.16}"
      },
      "border": {
        "$value": "{core.color.alpha.blue-400.50}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{core.color.blue.300}"
      }
    },
    "status": {
      "success": {
        "fg": {
          "$value": "{core.color.green.300}"
        },
        "bg": {
          "$value": "{core.color.alpha.green-300.14}"
        },
        "border": {
          "$value": "{core.color.alpha.green-300.40}"
        }
      },
      "warning": {
        "fg": {
          "$value": "{core.color.amber.300}"
        },
        "bg": {
          "$value": "{core.color.alpha.amber-300.14}"
        },
        "border": {
          "$value": "{core.color.alpha.amber-300.40}"
        }
      },
      "danger": {
        "fg": {
          "$value": "{core.color.red.300}"
        },
        "bg": {
          "$value": "{core.color.alpha.red-300.14}"
        },
        "border": {
          "$value": "{core.color.alpha.red-300.40}"
        },
        "solid": {
          "$value": "{core.color.red.300}"
        },
        "on-solid": {
          "$value": "{core.color.slate.950}"
        }
      },
      "ai": {
        "fg": {
          "$value": "{core.color.violet.300}"
        },
        "bg": {
          "$value": "{core.color.alpha.violet-300.14}"
        },
        "border": {
          "$value": "{core.color.alpha.violet-300.40}"
        }
      },
      "neutral": {
        "fg": {
          "$value": "{core.color.slate.350}"
        },
        "bg": {
          "$value": "{core.color.alpha.white.8}"
        }
      }
    }
  },
  "skeleton": {
    "$type": "color",
    "bg": {
      "$value": "{core.color.alpha.white.12}",
      "$description": "Fill of a loading placeholder. Decorative: it carries no information, so no contrast minimum applies (WCAG 1.4.11)."
    },
    "shine": {
      "$value": "{core.color.alpha.white.8}",
      "$description": "The band that sweeps across a placeholder while it loads. Lighter than the fill in both modes."
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Dark modes: a black shadow barely shows on a dark canvas, so the alpha is stronger and the floating levels add a 1px top highlight, the edge light catches.",
    "sm": {
      "$value": [
        {
          "color": "{core.shadow-color.40}",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ]
    },
    "md": {
      "$value": [
        {
          "color": "{core.shadow-color.55}",
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "0px"
        },
        {
          "color": "{core.color.alpha.white.8}",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        }
      ]
    },
    "lg": {
      "$value": [
        {
          "color": "{core.shadow-color.70}",
          "offsetX": "0px",
          "offsetY": "18px",
          "blur": "48px",
          "spread": "0px"
        },
        {
          "color": "{core.shadow-color.40}",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px"
        },
        {
          "color": "{core.color.alpha.white.12}",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        }
      ]
    }
  }
}
