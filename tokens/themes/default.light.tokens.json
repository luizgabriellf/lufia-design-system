{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{core.color.slate.50}"
      },
      "surface": {
        "$value": "{core.color.white}"
      },
      "surface-raised": {
        "$value": "{core.color.slate.100}"
      },
      "surface-solid": {
        "$value": "{core.color.white}"
      },
      "field": {
        "$value": "{core.color.white}"
      },
      "field-autofill": {
        "$value": "{core.color.white}",
        "$description": "Fill behind text the browser autofilled. Opaque: the browser paints its own tint unless an opaque inset shadow covers it."
      }
    },
    "text": {
      "default": {
        "$value": "{core.color.slate.900}"
      },
      "muted": {
        "$value": "{core.color.slate.600}"
      },
      "subtle": {
        "$value": "{core.color.slate.550}"
      },
      "on-accent": {
        "$value": "{core.color.white}"
      },
      "accent": {
        "$value": "{core.color.blue.800}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{core.color.alpha.slate-900.14}"
      },
      "strong": {
        "$value": "{core.color.alpha.slate-900.30}"
      }
    },
    "accent": {
      "default": {
        "$value": "{core.color.blue.700}"
      },
      "hover": {
        "$value": "{core.color.blue.800}"
      },
      "subtle": {
        "$value": "{core.color.alpha.blue-700.10}"
      },
      "border": {
        "$value": "{core.color.alpha.blue-700.35}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{core.color.blue.700}"
      }
    },
    "status": {
      "success": {
        "fg": {
          "$value": "{core.color.green.800}"
        },
        "bg": {
          "$value": "{core.color.alpha.green-700.10}"
        },
        "border": {
          "$value": "{core.color.alpha.green-700.35}"
        }
      },
      "warning": {
        "fg": {
          "$value": "{core.color.amber.800}"
        },
        "bg": {
          "$value": "{core.color.alpha.amber-800.10}"
        },
        "border": {
          "$value": "{core.color.alpha.amber-800.35}"
        }
      },
      "danger": {
        "fg": {
          "$value": "{core.color.red.700}"
        },
        "bg": {
          "$value": "{core.color.alpha.red-700.10}"
        },
        "border": {
          "$value": "{core.color.alpha.red-700.35}"
        },
        "solid": {
          "$value": "{core.color.red.700}"
        },
        "on-solid": {
          "$value": "{core.color.white}"
        }
      },
      "ai": {
        "fg": {
          "$value": "{core.color.violet.700}"
        },
        "bg": {
          "$value": "{core.color.alpha.violet-700.10}"
        },
        "border": {
          "$value": "{core.color.alpha.violet-700.35}"
        }
      },
      "neutral": {
        "fg": {
          "$value": "{core.color.slate.600}"
        },
        "bg": {
          "$value": "{core.color.slate.100}"
        }
      }
    }
  },
  "skeleton": {
    "$type": "color",
    "bg": {
      "$value": "{core.color.alpha.slate-900.14}",
      "$description": "Fill of a loading placeholder. Decorative: it carries no information, so no contrast minimum applies (WCAG 1.4.11)."
    },
    "shine": {
      "$value": "{core.color.alpha.white.60}",
      "$description": "The band that sweeps across a placeholder while it loads. Lighter than the fill in both modes."
    }
  }
}
