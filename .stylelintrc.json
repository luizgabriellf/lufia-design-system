{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "declaration-property-value-disallowed-list": {
      "outline": ["none", "0"],
      "/^outline(-style)?$/": ["none"],
      "/^(text-align|float|clear)$/": ["left", "right"]
    },
    "property-disallowed-list": [
      [
        "left",
        "right",
        "/^(margin|padding|scroll-margin|scroll-padding)-(left|right)$/",
        "/^border-(left|right)(-.+)?$/",
        "/^border-(top|bottom)-(left|right)-radius$/"
      ],
      {
        "message": "Use the logical property (inset-inline-start, margin-inline-end, ...) so right-to-left works."
      }
    ],
    "color-named": "never",
    "declaration-no-important": true
  },
  "overrides": [
    {
      "files": ["**/*.module.css"],
      "rules": {
        "color-no-hex": [true, { "message": "Use a --lufia-* semantic token instead of a raw colour." }],
        "function-disallowed-list": ["rgb", "rgba", "hsl", "hsla"]
      }
    }
  ]
}
